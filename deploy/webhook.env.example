# Copy to /etc/vanadium5e-webhook.env, then: chown root:vanadium-deploy and chmod 640.
# Never commit the real file.

# Same value as the "Secret" field of the GitHub webhook. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-me

V5_GIT_DIR=/srv/vanadium5e/repo.git
V5_WEB_ROOT=/var/www/vanadium5e
V5_LISTEN_HOST=127.0.0.1
V5_LISTEN_PORT=9055

# Private repo only: read-only GitHub deploy key + pinned github.com host keys (see deploy/README.md).
# Leave both empty if the repo is public.
V5_DEPLOY_KEY=/srv/vanadium5e/deploy_key
V5_KNOWN_HOSTS=/srv/vanadium5e/known_hosts

# 1 = refuse to deploy commits whose signature git can't verify (needs your signing key set up on the server)
V5_REQUIRE_SIGNED=0
