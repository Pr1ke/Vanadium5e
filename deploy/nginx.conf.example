# Inside your existing HTTPS server block for the site (nginx).
# Only the webhook path is forwarded; everything else stays plain static files.

limit_req_zone $binary_remote_addr zone=v5hook:1m rate=10r/m;   # put this line in the http {} block

server {
    # ... your existing listen 443 ssl; server_name; ssl_certificate ... lines ...

    root /var/www/vanadium5e;
    index index.html;

    # repo maintenance files don't need to be public
    location ~ ^/(deploy|tools)/ { return 404; }
    location ~ /\. { return 404; }

    location = /hooks/vanadium5e {
        limit_req zone=v5hook burst=5 nodelay;
        limit_except POST { deny all; }
        client_max_body_size 2m;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:9055;
    }
}

